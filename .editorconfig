# EditorConfig — https://editorconfig.org
#
# Line endings are LF everywhere, matching `.gitattributes` (`* text=auto
# eol=lf`). Byte-identical checkouts across Windows and Unix are a
# prerequisite for the reproducible builds described in ARCHITECTURE.md §24.12.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# --- Rust ---------------------------------------------------------------
[*.rs]
indent_size = 4
max_line_length = 100

# --- Kotlin / Java / Gradle ---------------------------------------------
[*.{kt,kts,java}]
indent_size = 4
max_line_length = 120

[*.pro]
indent_size = 4

# --- Web, config, and data ----------------------------------------------
[*.{ts,tsx,js,jsx,mjs,cjs,css,html}]
indent_size = 2

[*.{json,json5,jsonc}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.toml]
indent_size = 2

# --- Markdown -----------------------------------------------------------
# Trailing whitespace is significant in Markdown: two spaces at end of line
# is a hard line break. Stripping it silently changes rendered output.
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# --- Shell and Windows scripts ------------------------------------------
[*.sh]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf
indent_size = 4

# --- Files with fixed formats -------------------------------------------
[Makefile]
indent_style = tab

[{LICENSE,NOTICE,*.lock}]
trim_trailing_whitespace = false
insert_final_newline = false
