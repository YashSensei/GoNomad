node_modules/
.pnpm-store/
*.tsbuildinfo

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
*.iml

# OS
.DS_Store
Thumbs.db
desktop.ini

# GoNomad runtime state (never commit — contains keys and audit data)
.gonomad/
*.gonomad-identity

