<?xml version="1.0" encoding="utf-8"?>
<!-- Device keys and pairing state must never leave the device via backup or
     device-to-device transfer: losing the key means re-pairing, by design
     (README, "Known limitations"). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
